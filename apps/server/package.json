{
	"name": "@e-invoice-eu/server",
	"version": "3.2.0",
	"description": "REST API for generating EN16931 conforming electronic invoices",
	"keywords": [
		"factur-x",
		"zugferd",
		"e-invoice",
		"ubl",
		"cii",
		"en16931",
		"xrechnung",
		"pdfa",
		"e-rechnung",
		"e-invoice-eu",
		"einvoice",
		"erechnung",
		"electronic invoice"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gflohr/e-invoice-eu.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "commonjs",
	"homepage": "https://github.com/gflohr/e-invoice-eu/tree/main/apps/server#readme",
	"author": "Guido Flohr <guido.flohr@cantanea.com> (http://www.guido.flohr.net/)",
	"dependencies": {
		"@e-invoice-eu/core": "workspace:*",
		"@nestjs/common": "^12.0.1",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.1",
		"@nestjs/platform-express": "^12.0.1",
		"@nestjs/swagger": "^12.0.1",
		"@valibot/i18n": "^1.2.0",
		"ajv": "^8.20.0",
		"js-yaml": "^5.4.1",
		"rxjs": "^7.8.2",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@nestjs/cli": "^12.0.0",
		"@nestjs/schematics": "^12.0.0",
		"@nestjs/testing": "^12.0.1",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.4.1",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^5.0.0",
		"rimraf": "^6.1.3",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"files": ["dist"],
	"bin": {
		"e-invoice-eu-server": "dist/main.js"
	},
	"engines": {
		"node": ">=20.19.0 <21.0.0 || >=22.12.0"
	},
	"license": "WTFPL",
	"scripts": {
		"build": "rimraf dist && nest build -p tsconfig.build.json && chmod +x dist/main.js",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"test": "vitest --run",
		"test:cov": "vitest --coverage.enabled --run",
		"test:cov-changed": "vitest --coverage.enabled --run --changed origin/main --passWithNoTests",
		"test:watch": "vitest",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/vitest --no-file-parallelism"
	},
	"gitHead": "67a67ee76bd444a1bfe18057baad1a72a8152dd1"
